{
  "manifest_version": 3,
  "name": "Python AI Browser Bridge",
  "version": "0.2.0",
  "description": "Ponte segura entre a Python AI e o Chrome, com consentimento granular e auditoria local.",
  "permissions": ["tabs", "activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mt2468.github.io/test-MT/python-ai/web/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Python AI Browser Bridge"
  }
}
